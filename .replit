deploy.run = ["sh", "-c", "npm run build && npm start"]

run = ["npm", "start"]

language = "nodejs"
entrypoint = "package.json"
modules = ["nodejs-20"]

onBoot = "npm install && npm run build"

[packager]
language = "nodejs"
ignoredPackages = ["**/node_modules"]
packageSearch = true
packageIgnore = ["**/node_modules"]

